---
import Layout from '../layouts/Layout.astro';
---
<Layout title="About">
  <section class="max-w-5xl mx-auto px-6 py-24 grid md:grid-cols-2 gap-14 items-center">
    <div class="aspect-[4/5] rounded-2xl border border-white/25 flex items-center justify-center text-white/50 text-sm uppercase tracking-wide order-2 md:order-1">
      Professional photo
    </div>
    <div class="order-1 md:order-2">
      <p class="uppercase tracking-[0.25em] text-sm text-white/60 mb-4">About Me</p>
      <h1 class="text-4xl mb-6">Hi, I'm Leah</h1>
      <p class="text-white/85 leading-relaxed mb-4">
        I'm a Registered Nutritionist and Yoga Instructor, and I believe good health should feel
        calm, not chaotic. My approach blends evidence-based nutrition with mindful movement. There's
        no fads, no extremes, just what actually works for your body and your life.
      </p>
      <p class="text-white/85 leading-relaxed mb-4">
        [Space for your story - how you got into nutrition and yoga, what drives you, and what
        clients can expect working with you.]
      </p>
    </div>
  </section>

  <section class="border-t border-white/15">
    <div class="max-w-4xl mx-auto px-6 py-16 text-center">
      <p class="uppercase tracking-[0.25em] text-sm text-white/60 mb-4">Credentials</p>
      <h2 class="text-2xl mb-8">Registrations &amp; Qualifications</h2>
      <div class="flex flex-wrap justify-center items-center gap-8 mb-8">
        <img src="/images/ryt-500.jpeg" alt="RYT 500 Registered Yoga Teacher, Yoga Alliance" class="w-28 h-28 rounded-full bg-white p-1" />
        <img src="/images/anutr.png" alt="AfN ANutr Registered Associate Nutritionist" class="h-24 bg-white rounded-lg p-3" />
      </div>
      <div class="grid sm:grid-cols-2 gap-4 text-left max-w-xl mx-auto">
        <div class="border border-white/20 rounded-xl p-5">
          <p class="text-white/85">Registered Yoga Teacher (RYT 500), Yoga Alliance</p>
        </div>
        <div class="border border-white/20 rounded-xl p-5">
          <p class="text-white/85">Registered Associate Nutritionist (ANutr), Association for Nutrition</p>
        </div>
        <div class="border border-white/20 rounded-xl p-5">
          <p class="text-white/85">[Yoga teaching certification]</p>
        </div>
        <div class="border border-white/20 rounded-xl p-5">
          <p class="text-white/85">[Additional qualification]</p>
        </div>
      </div>
      <p class="text-white/60 text-sm mt-6">Full registration details to be added.</p>
    </div>
  </section>
</Layout>
