---
import Layout from '../layouts/Layout.astro';
---
<Layout title="About">
  <section class="max-w-5xl mx-auto px-6 py-24 grid md:grid-cols-2 gap-14 items-center">
    <div class="aspect-[4/5] rounded-2xl border border-white/25 flex items-center justify-center text-white/50 text-sm uppercase tracking-wide">
      <img src="public\images\86a86640-6d89-4330-b228-f59bbc02c941.jpeg" alt="About me photo" class="aspect-[4/5] rounded-2xl border border-white/25 flex items-center justify-center text-white/50 text-sm uppercase tracking-wide order-2 md:order-1" />
    </div>

    <div class="order-1 md:order-2">
      <p class="uppercase tracking-[0.25em] text-sm text-white/60 mb-4">About Me</p>
      <h1 class="text-4xl mb-6">Hi, I'm Leah</h1>
      <p class="text-white/85 leading-relaxed mb-4">
        I'm a Registered Nutritionist and Yoga Instructor, and I believe good health should feel
        calm, not chaotic. My approach blends evidence-based nutrition with mindful movement. There's
        no fads, no extremes, just what actually works for your body and your life.
      </p>
    </div>
  </section>

  <section class="bg-white text-terra-500">
    <div class="max-w-4xl mx-auto px-6 py-16 text-center">
      <p class="uppercase tracking-[0.25em] text-sm text-terra-500/70 mb-4">Credentials</p>
      <h2 class="text-2xl mb-8">Registrations &amp; Qualifications</h2>
      <div class="flex flex-wrap justify-center items-center gap-8 mb-8">
        <img src="/images/anutr.png" alt="AfN ANutr Registered Associate Nutritionist" class="h-24 bg-white border border-terra-500/25 rounded-lg p-3" />
        
      </div>
      <div class="grid sm:grid-cols-2 gap-4 text-left max-w-xl mx-auto">
        <div class="border border-terra-500/25 rounded-xl p-5">
          <p class="text-terra-500/85">Registered Associate Nutritionist (ANutr), Association for Nutrition</p>
        </div>
        <div class="border border-terra-500/25 rounded-xl p-5">
          <p class="text-terra-500/85">Registered Yoga Teacher (RYT 500), Yoga Alliance</p>
        </div>
      </div>
    </div>
  </section>
</Layout>
