---
import Layout from '../layouts/Layout.astro';

const links = [
  { label: 'Practice Yoga With Me', href: '/yoga' },
  { label: 'Nutrition Coaching', href: '/nutrition' },
  { label: '1:1', href: '/services' },
  { label: 'Book a Discovery Call', href: '/services' },
  { label: 'Explore My Website', href: '/' },
].map((l) => ({
  ...l,
  isExternal: l.href.startsWith('http'),
}));
---
<Layout title="Links">
  <section class="px-6 pt-24 pb-16">
    <div class="w-full max-w-sm mx-auto text-center">
      <img src="/images/LeahHeadshot.jpg" alt="Leah Kanellos" class="w-24 h-24 rounded-full object-cover mx-auto mb-6 border border-white/30" />
      <h1 class="text-2xl font-display mb-2">Leah Kanellos</h1>
      <p class="text-white/75 text-sm mb-10">Registered Associate Nutritionist &amp; Yoga Instructor</p>

      <div class="space-y-3">
        {links.map((l) => (
          l.isExternal ? (
            <a href={l.href} target="_blank" rel="noopener" class="block border border-white/30 rounded-full py-3 px-6 text-sm hover:bg-white/10 transition">
              {l.label}
            </a>
          ) : (
            <a href={l.href} class="block border border-white/30 rounded-full py-3 px-6 text-sm hover:bg-white/10 transition">
              {l.label}
            </a>
          )
        ))}
      </div>
    </div>
  </section>
</Layout>
