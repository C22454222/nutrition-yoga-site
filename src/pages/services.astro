---
import Layout from '../layouts/Layout.astro';

const services = [
  {
    name: 'Free Discovery Call',
    duration: '15 minutes',
    price: 'Free',
    desc: 'A relaxed, no-pressure chat to see if we\'re a good fit and talk through your goals.',
  },
  {
    name: 'Initial Coaching Session',
    duration: '60 minutes',
    price: 'Price TBC',
    desc: 'An in-depth first session covering your history, goals, and a personalised starting plan.',
  },
  {
    name: 'Follow-up Coaching Session',
    duration: '45 minutes',
    price: 'Price TBC',
    desc: 'Ongoing sessions to review progress, adjust your plan, and keep momentum going.',
  },
  {
    name: 'Accountability / Check-in Call',
    duration: '20 minutes',
    price: 'Price TBC',
    desc: 'A shorter check-in between full sessions to stay on track and troubleshoot.',
  },
];
---
<Layout title="Services">
  <section class="max-w-3xl mx-auto px-6 pt-24 pb-14 text-center">
    <p class="uppercase tracking-[0.25em] text-sm text-white/60 mb-4">Coaching</p>
    <h1 class="text-4xl mb-6">Services &amp; Pricing</h1>
    <p class="text-white/85">
      Simple, flexible coaching options. Start with a free call, with no obligation.
    </p>
  </section>

  <section class="bg-white text-terra-900">
    <div class="max-w-5xl mx-auto px-6 py-24">
      <div class="grid md:grid-cols-2 gap-6">
        {services.map((s) => (
          <div class="border border-terra-200 rounded-2xl p-8 bg-terra-50">
            <div class="flex items-baseline justify-between mb-2">
              <h3 class="text-xl text-terra-700">{s.name}</h3>
              <span class="text-terra-500 text-sm">{s.duration}</span>
            </div>
            <p class="text-terra-800 text-sm leading-relaxed mb-4">{s.desc}</p>
            <div class="flex items-center justify-between">
              <span class="text-lg font-display text-terra-700">{s.price}</span>
              <a href="/contact" class="text-sm underline text-terra-600 hover:text-terra-800 transition">Book now</a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>