---
import Layout from '../layouts/Layout.astro';

const WEB3FORMS_ACCESS_KEY = "b1dec726-cbf5-4a4b-a49c-82e2251eb72e";

const reviews = [
  { name: 'Client Name', rating: 5, text: 'Placeholder testimonial: replace with a real review.' },
  { name: 'Client Name', rating: 5, text: 'Placeholder testimonial: replace with a real review.' },
  { name: 'Client Name', rating: 5, text: 'Placeholder testimonial: replace with a real review.' },
];
---

<Layout title="Reviews">
  <section class="max-w-3xl mx-auto px-6 pt-24 pb-14 text-center">
    <p class="uppercase tracking-[0.25em] text-sm text-white/60 mb-4">Reviews</p>
    <h1 class="text-4xl mb-6">Share Your Experience</h1>
    <p class="text-white/85">
      Leave a review, and once it's checked, it can be published on this page.
    </p>
  </section>

  <!-- Leave a review FIRST -->
  <section>
    <div class="max-w-xl mx-auto px-6 py-20">
      <h2 class="text-2xl mb-3 text-center">Leave a Review</h2>
      <p class="text-white/70 text-sm text-center mb-8">
        Submitted reviews are checked before they're published.
      </p>

      <form id="review-form" class="space-y-4">
        <input type="hidden" name="access_key" value={WEB3FORMS_ACCESS_KEY} />
        <input type="hidden" name="subject" value="New review submitted on website" />
        <input type="hidden" name="from_name" value="Leah's Website Reviews" />
        <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />

        <input
          type="text"
          name="name"
          placeholder="Your name"
          required
          class="w-full border border-white/25 bg-white/5 rounded-lg px-4 py-2 text-white placeholder-white/50"
        />
        <select
          name="rating"
          required
          class="w-full border border-white/25 bg-white/5 rounded-lg px-4 py-2 text-white"
        >
          <option value="" class="text-terra-500">Rating</option>
          <option value="5" class="text-terra-500">★★★★★</option>
          <option value="4" class="text-terra-500">★★★★</option>
          <option value="3" class="text-terra-500">★★★</option>
          <option value="2" class="text-terra-500">★★</option>
          <option value="1" class="text-terra-500">★</option>
        </select>
        <textarea
          name="message"
          placeholder="Your review"
          rows="5"
          required
          class="w-full border border-white/25 bg-white/5 rounded-lg px-4 py-2 text-white placeholder-white/50"
        ></textarea>
        <button
          type="submit"
          class="w-full bg-white text-terra-500 py-2 rounded-full hover:bg-white/90 transition font-medium"
        >
          Submit Review
        </button>
        <p id="review-status" role="status" class="text-sm text-center min-h-[1.2rem]"></p>
      </form>
    </div>
  </section>

  <!-- Testimonials AFTER the form -->
  <section class="bg-white text-terra-500">
    <div class="max-w-5xl mx-auto px-6 py-20">
      <h2 class="text-3xl text-center mb-10">What Clients Say</h2>
      <div class="grid md:grid-cols-3 gap-6">
        {reviews.map((r) => (
          <div class="border border-terra-500/25 rounded-2xl p-7">
            <div class="text-terra-500 mb-3">
              {'★'.repeat(r.rating)}
              {'☆'.repeat(5 - r.rating)}
            </div>
            <p class="text-terra-500/85 text-sm leading-relaxed mb-4">
              "{r.text}"
            </p>
            <p class="text-terra-500/70 text-sm">By {r.name}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>

<script>
  const form = document.getElementById('review-form') as HTMLFormElement;
  const status = document.getElementById('review-status') as HTMLParagraphElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    submitBtn.disabled = true;
    status.textContent = 'Sending…';

    const formData = new FormData(form);
    const object: Record<string, string> = {};
    formData.forEach((value, key) => { object[key] = value.toString(); });
    const json = JSON.stringify(object);

    try {
      const res = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: json,
      });
      const result = await res.json();

      if (result.success) {
        status.textContent = 'Thanks! Your review has been submitted for approval.';
        form.reset();
      } else {
        status.textContent = 'Something went wrong. Please try again.';
        console.error(result);
      }
    } catch (err) {
      status.textContent = 'Network error. Please try again.';
      console.error(err);
    } finally {
      submitBtn.disabled = false;
    }
  });
</script>
